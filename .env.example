# Copie este arquivo para .env para rodar localmente (o .env já está no .gitignore
# e nunca deve ser commitado). Em produção, essas mesmas chaves viram Secrets no
# GitHub Actions e variáveis de ambiente no Render — nunca ficam num arquivo versionado.

APP_ENV=local
PORT=8080
LOG_LEVEL=DEBUG

# Habilita o scheduler interno (mantenha "false" se o GitHub Actions já faz as checagens
# periódicas — evita e-mail duplicado). Só ligue como "true" se estiver rodando localmente
# sem o workflow do GitHub Actions.
ENABLE_INTERNAL_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=6

HTTP_TIMEOUT_MS=10000
HTTP_RETRY_COUNT=1
RATE_LIMIT_PER_MINUTE=120

# Amadeus for Developers (https://developers.amadeus.com)
# Comece com o ambiente de teste (padrão). Depois de solicitar acesso de produção,
# troque AMADEUS_BASE_URL para https://api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
# Limita quantas datas dentro de uma janela (ex: um mês inteiro) são consultadas por
# checagem, para não estourar a cota gratuita da Amadeus.
AMADEUS_MAX_DATES_PER_CHECK=10

# Destinatários do alerta (separados por vírgula)
ALERT_RECIPIENTS=seu@email.com

# Banco de dados: H2 local (padrão) ou Postgres/Supabase em produção
# Exemplo Supabase: jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_URL=jdbc:h2:file:./data/flightdb;AUTO_SERVER=TRUE;MODE=PostgreSQL
DB_USER=sa
DB_PASSWORD=

# SMTP (ex: Gmail com "senha de app")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
